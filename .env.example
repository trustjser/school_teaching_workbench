# ---------------------------------------------------------------------------
# 前端环境变量样例（复制为 .env.local 后按需修改）
# 说明：端口 / mDNS 服务类型以 Rust 侧 config/constants.rs 为准，
#      这里仅用于前端展示与浏览器直连调试（生产环境由 Tauri 命令回读真实值）
# ---------------------------------------------------------------------------

# 本地 P2P API 端口（与 Rust API_PORT 对齐，默认 5178）
VITE_API_PORT=5178

# mDNS 服务类型（与 Rust MDNS_SERVICE_TYPE 对齐）
VITE_MDNS_TYPE=_schworkbench._tcp.local.

# API 版本前缀
VITE_API_VERSION=v1

# 调试开关：true 时前端打印 invoke/事件日志
VITE_DEBUG=false

# 大屏缩放初始值 1.0 / 1.25 / 1.5（运行期可在设置页修改并落库）
VITE_UI_SCALE=1.25
